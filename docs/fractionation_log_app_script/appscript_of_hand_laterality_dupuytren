/**
 * Legacy wrapper kept so old references do not break.
 */
function calculateSum(sheet, sCol, tCol, start) {
  const last = Math.max(start, sheet.getLastRow());
  const data = sheet.getRange(start, sCol, last - start + 1, 1).getValues();
  const results = [];
  let total = 0;

  for (let i = 0; i < data.length; i++) {
    const v = Number(data[i][0]);

    if (data[i][0] === "" || isNaN(v)) {
      results.push([""]);
    } else {
      total += v;
      results.push([total]);
    }
  }

  sheet.getRange(start, tCol, results.length, 1).setValues(results);
}


