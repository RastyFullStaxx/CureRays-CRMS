/* ============================================================
 * EDIT TRIGGERS
 * ============================================================
 */

/**
 * Simple onEdit trigger.
 *
 * This keeps formulas alive when staff edit treatment inputs.
 * It intentionally does not reapply dropdown validations or broad formatting.
 */
function onEdit(e) {
  if (!e || !e.range) return;

  const range = e.range;
  const sheet = range.getSheet();

  if (!isDupuytrensSheet_(sheet)) return;

  if (rangeTouchesPrescriptionEnergyRow_(range)) {
    applyPrescriptionEnergyColorCoding_(sheet, null);
  }

  if (!rangeTouchesRows_(range, DUP_PATCH.START_ROW, DUP_PATCH.END_ROW)) return;

  const inputCols = [
    DUP_PATCH.COL_PHASE,
    DUP_PATCH.COL_ENERGY,
    DUP_PATCH.COL_SSD,
    DUP_PATCH.COL_TIME,
    DUP_PATCH.COL_DOSE_PER_FX,
    DUP_PATCH.COL_SKIN_DOSE,
    DUP_PATCH.COL_DEPTH
  ];

  const formulaCols = [
    DUP_PATCH.COL_CUM_DOSE,
    DUP_PATCH.COL_CUM_SKIN_DOSE,
    DUP_PATCH.COL_ISODOSE,
    DUP_PATCH.COL_DOSE_TO_DOT,
    DUP_PATCH.COL_CUM_DOT,
    DUP_PATCH.COL_ROUNDED_DEPTH
  ];

  if (rangeTouchesAnyColumn_(range, inputCols) || rangeTouchesAnyColumn_(range, formulaCols)) {
    restoreFormulasForTouchedRows_(sheet, range);
  }

  if (rangeTouchesAnyColumn_(range, [
    DUP_PATCH.COL_PHASE,
    DUP_PATCH.COL_ENERGY,
    DUP_PATCH.COL_MD_APPROVAL,
    DUP_PATCH.COL_DOT_APPROVAL
  ])) {
    applyDropdownValueColorCodingForTouchedRows_(sheet, range);
  }

  applySafeWrapToEditedRows_(sheet, range);
}


/**
 * Installable onEdit trigger.
 *
 * This handles MD approval stamping.
 * Installable triggers are more reliable for user email lookup.
 */
function installedDupuytrensOnEdit(e) {
  if (!e || !e.range) return;

  const range = e.range;
  const sheet = range.getSheet();

  if (!isDupuytrensSheet_(sheet)) return;

  if (rangeTouchesPrescriptionEnergyRow_(range)) {
    applyPrescriptionEnergyColorCoding_(sheet, null);
  }

  if (!rangeTouchesRows_(range, DUP_PATCH.START_ROW, DUP_PATCH.END_ROW)) return;

  if (rangeTouchesColumn_(range, DUP_PATCH.COL_MD_APPROVAL)) {
    handleApprovalTrackingBlock_(e, sheet, range);
    applyDropdownValueColorCodingForTouchedRows_(sheet, range);
    applySafeWrapToEditedRows_(sheet, range);
  }
}


