/* ============================================================
 * SHEET DETECTION
 * ============================================================
 */

/**
 * Returns all Dupuytrens treatment sheets in the spreadsheet.
 */
function getDupuytrensSheets_(ss) {
  return ss.getSheets().filter(sheet => isDupuytrensSheet_(sheet));
}


/**
 * Detects the Dupuytrens treatment sheet.
 *
 * This supports both the current visible tab name, "Dupuytrens",
 * and the older name assumed by the pasted script, "Dupuytren's".
 */
function isDupuytrensSheet_(sheet) {
  if (!sheet) return false;

  const name = sheet.getName().trim();
  if (DUP_PATCH.SHEET_NAMES.indexOf(name) !== -1) return true;

  const a1 = String(sheet.getRange("A1").getDisplayValue()).toLowerCase().trim();
  const d9 = String(sheet.getRange("D9").getDisplayValue()).toLowerCase().trim();
  const q9 = String(sheet.getRange("Q9").getDisplayValue()).toLowerCase().trim();

  return a1.indexOf("patient name") !== -1 &&
    d9 === "phase" &&
    q9.indexOf("depth") !== -1;
}


/* ============================================================
 * PRESCRIPTION AND LOOKUP REPAIRS
 * ============================================================
 */

/**
 * Repairs prescription totals without touching colors or dropdowns.
 */
function repairKnownPrescriptionTotals_(sheets, report) {
  sheets.forEach(sheet => {
    sheet.getRange("S5").setFormula("=SUM(L5:R5)");
    sheet.getRange("S7").setFormula("=SUM(L7:R7)");

    log_(report, "FIXED", sheet.getName(), "Prescription totals repaired in S5 and S7.");
  });
}


/**
 * Repairs known lookup-table issue if it exists.
 */
function repairKnownLookupIssues_(ss, report) {
  const sheet70 = ss.getSheetByName("70 kV");

  if (!sheet70) {
    log_(report, "WARN", "Lookup repair", "70 kV sheet not found. Skipped known lookup repair.");
    return;
  }

  const et21 = sheet70.getRange("ET21");
  const et21Display = String(et21.getDisplayValue()).trim();

  if (et21Display === "38,2" || et21Display.replace(",", ".") === "38.2") {
    et21.setValue(38.2);
    log_(report, "FIXED", "Lookup repair", "70 kV!ET21 corrected to numeric 38.2.");
  }

  const et6 = sheet70.getRange("ET6");
  const et6Display = String(et6.getDisplayValue()).trim();

  if (et6Display.indexOf("#VALUE") !== -1 || et6Display === "") {
    et6.setFormula("=ET21/100");
    log_(report, "FIXED", "Lookup repair", "70 kV!ET6 formula repaired as =ET21/100.");
  }
}


/* ============================================================
 * FORMULA RESTORATION
 * ============================================================
 */

/**
 * Restores formula-driven calculation columns.
 *
 * Formula columns:
 * - I: cumulative prescription dose
 * - K: cumulative skin-surface dose
 * - R: isodose to DOT
 * - S: dose to DOT
 * - T: cumulative dose to DOT
 * - U: rounded depth helper
 *
 * Column Q remains the DOT depth input.
 */
function restoreAllDupuytrensFormulas_(sheet, report) {
  restoreFormulasForRows_(sheet, DUP_PATCH.START_ROW, DUP_PATCH.END_ROW);

  try {
    sheet.hideColumns(DUP_PATCH.COL_ROUNDED_DEPTH);
  } catch (err) {
    log_(report, "WARN", sheet.getName(), "Could not hide helper Column U: " + err.message);
  }

  log_(
    report,
    "FIXED",
    sheet.getName(),
    "Formula columns restored in I, K, R, S, T, and U. Column Q remains the DOT depth input."
  );
}


/**
 * Restores formulas only for rows touched by an edit.
 */
function restoreFormulasForTouchedRows_(sheet, range) {
  const startRow = Math.max(range.getRow(), DUP_PATCH.START_ROW);
  const endRow = Math.min(range.getRow() + range.getNumRows() - 1, DUP_PATCH.END_ROW);

  if (startRow > endRow) return;

  restoreFormulasForRows_(sheet, startRow, endRow);
}


/**
 * Writes formulas for treatment rows only.
 *
 * Separator rows such as "PHASE II" are skipped.
 */
function restoreFormulasForRows_(sheet, startRow, endRow) {
  for (let row = startRow; row <= endRow; row++) {
    if (!isTreatmentRow_(sheet, row)) continue;

    sheet.getRange(row, DUP_PATCH.COL_CUM_DOSE)
      .setFormula(`=IF($H${row}="","",SUM($H$${DUP_PATCH.START_ROW}:H${row}))`)
      .setNumberFormat("0.00");

    sheet.getRange(row, DUP_PATCH.COL_CUM_SKIN_DOSE)
      .setFormula(`=IF($J${row}="","",SUM($J$${DUP_PATCH.START_ROW}:J${row}))`)
      .setNumberFormat("0.00");

    sheet.getRange(row, DUP_PATCH.COL_ISODOSE)
      .setFormula(buildIsodoseFormula_(row))
      .setNumberFormat("0.00%");

    sheet.getRange(row, DUP_PATCH.COL_DOSE_TO_DOT)
      .setFormula(`=IF(OR($R${row}="",AND($J${row}="",$H${row}="")),"",$R${row}*IF($J${row}<>"",$J${row},$H${row}))`)
      .setNumberFormat("0.00");

    sheet.getRange(row, DUP_PATCH.COL_CUM_DOT)
      .setFormula(`=IF($S${row}="","",SUM($S$${DUP_PATCH.START_ROW}:S${row}))`)
      .setNumberFormat("0.00");

    sheet.getRange(row, DUP_PATCH.COL_ROUNDED_DEPTH)
      .setFormula(`=IF($Q${row}="","",ROUND($Q${row},1))`)
      .setNumberFormat("0.00");
  }
}


/**
 * Builds the row formula for Isodose to DOT.
 */
function buildIsodoseFormula_(row) {
  return `=IF(OR($D${row}="",$E${row}="",$Q${row}=""),"",IFERROR(LET(fs,INDEX($L$8:$R$8,1,MATCH($D${row},$L$1:$R$1,0)),raw,INDEX(INDIRECT("'"&$E${row}&"'!A:ZZ"),MATCH(fs,INDIRECT("'"&$E${row}&"'!A:A"),0),MATCH(ROUND($Q${row},1),ARRAYFORMULA(IFERROR(ROUND(INDIRECT("'"&$E${row}&"'!1:1"),1),"")),0)),IF(raw>1,raw/100,raw)),""))`;
}


/**
 * Determines whether a row is a treatment row, not a phase separator.
 */
function isTreatmentRow_(sheet, row) {
  const fx = sheet.getRange(row, DUP_PATCH.COL_FX).getValue();
  const phase = String(sheet.getRange(row, DUP_PATCH.COL_PHASE).getDisplayValue()).trim();

  return typeof fx === "number" && phase.indexOf("Phase") === 0;
}


/* ============================================================
 * CONDITIONAL FORMATTING
 * ============================================================
 */

/**
 * Adds clinical mismatch highlighting without clearing existing colors.
 *
 * Compared columns:
 * - E: Energy
 * - F: SSD
 * - G: Tx Time
 * - H: Dose per Fraction
 * - J: Dose at skin surface per Fx
 */
function applyClinicalMismatchConditionalFormatting_(sheet, report) {
  const targetRanges = [
    sheet.getRange("E11:H80"),
    sheet.getRange("J11:J80")
  ];

  const formula =
    '=AND(E11<>"",$D11<>"",IFERROR(TO_TEXT(E11)<>TO_TEXT(INDEX($L$2:$R$6,MATCH(COLUMN(E11),{5,6,7,8,10},0),MATCH($D11,$L$1:$R$1,0))),FALSE))';

  const existingRules = sheet.getConditionalFormatRules();

  const filteredRules = existingRules.filter(rule => {
    const condition = rule.getBooleanCondition();
    if (!condition) return true;

    const isSameFormula =
      condition.getCriteriaType() === SpreadsheetApp.BooleanCriteria.CUSTOM_FORMULA &&
      condition.getCriteriaValues() &&
      condition.getCriteriaValues()[0] === formula;

    return !isSameFormula;
  });

  const mismatchRule = SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied(formula)
    .setBackground("#F4CCCC")
    .setFontColor("#800000")
    .setBold(true)
    .setRanges(targetRanges)
    .build();

  sheet.setConditionalFormatRules([mismatchRule].concat(filteredRules));

  log_(
    report,
    "FIXED",
    sheet.getName(),
    "Clinical mismatch color coding applied through conditional formatting. Existing base colors were not cleared."
  );
}


/* ============================================================
 * APPROVAL TRACKING
 * ============================================================
 */

/**
 * Tracks MD Approval edits in Column N.
 */
function handleApprovalTrackingBlock_(e, sheet, range) {
  const startRow = Math.max(range.getRow(), DUP_PATCH.START_ROW);
  const endRow = Math.min(range.getRow() + range.getNumRows() - 1, DUP_PATCH.END_ROW);

  if (startRow > endRow) return;

  for (let row = startRow; row <= endRow; row++) {
    if (!isTreatmentRow_(sheet, row)) continue;
    handleApprovalTrackingRow_(e, sheet, row);
  }
}


/**
 * Writes initials and timestamp when MD Approval changes.
 */
function handleApprovalTrackingRow_(e, sheet, row) {
  const status = String(sheet.getRange(row, DUP_PATCH.COL_MD_APPROVAL).getValue()).trim();
  const target = sheet.getRange(row, DUP_PATCH.COL_MD_INITIALS);

  if (status === "") {
    target.clearContent();
    return;
  }

  const email = String(Session.getActiveUser().getEmail()).toLowerCase().trim();
  let initials = "";

  const map = e.source.getSheetByName("UserMapping");
  if (map && email) {
    const data = map.getDataRange().getValues();

    for (let i = 1; i < data.length; i++) {
      if (String(data[i][0]).toLowerCase().trim() === email) {
        initials = String(data[i][1]).toUpperCase().trim();
        break;
      }
    }
  }

  if (!initials && email) {
    const namePart = email.split("@")[0];
    const parts = namePart.split(/[\.\-_]/);

    if (parts.length >= 2) {
      initials = (parts[0][0] + parts[1][0]).toUpperCase();
    } else {
      initials = namePart.substring(0, 2).toUpperCase();
    }
  }

  if (!initials) initials = "US";

  const time = Utilities.formatDate(new Date(), DUP_PATCH.TIMEZONE, "MM/dd/yyyy | hh:mm a");

  target
    .setValue(initials + " | " + time)
    .setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP)
    .setFontWeight(status === "Revise" ? "bold" : "normal")
    .setFontColor(status === "Revise" ? "#800000" : "#274e13");
}


/**
 * Installs the approval trigger.
 */
function installDupuytrensApprovalTrigger_(ss, report) {
  ScriptApp.getProjectTriggers()
    .filter(trigger => trigger.getHandlerFunction() === "installedDupuytrensOnEdit")
    .forEach(trigger => ScriptApp.deleteTrigger(trigger));

  ScriptApp.newTrigger("installedDupuytrensOnEdit")
    .forSpreadsheet(ss)
    .onEdit()
    .create();

  log_(report, "FIXED", "Trigger", "Installable MD approval trigger installed.");
}


/* ============================================================
 * DROPDOWN VALUE COLOR REPAIR
 * ============================================================
 */

/**
 * Repairs visible cell colors for dropdown-backed columns.
 *
 * This does not rebuild data validations.
 * It only colors the cells based on their current text value.
 */
function applyDropdownValueColorCoding_(sheet, startRow, endRow, report) {
  const firstRow = Math.max(startRow, DUP_PATCH.START_ROW);
  const lastRow = Math.min(endRow, DUP_PATCH.END_ROW);

  if (firstRow > lastRow) return;

  colorRangeByMap_(sheet, firstRow, lastRow, DUP_PATCH.COL_PHASE, getPhaseColorMap_());
  colorRangeByMap_(sheet, firstRow, lastRow, DUP_PATCH.COL_ENERGY, getEnergyColorMap_());
  colorRangeByMap_(sheet, firstRow, lastRow, DUP_PATCH.COL_MD_APPROVAL, getMdApprovalColorMap_());
  colorRangeByMap_(sheet, firstRow, lastRow, DUP_PATCH.COL_DOT_APPROVAL, getDotApprovalColorMap_());

  if (report) {
    log_(
      report,
      "FIXED",
      sheet.getName(),
      "Dropdown value colors repaired for Phase, Energy, MD Approval, and DOT Approval without recreating validations."
    );
  }
}


/**
 * Repairs dropdown colors only for edited rows.
 */
function applyDropdownValueColorCodingForTouchedRows_(sheet, range) {
  const startRow = Math.max(range.getRow(), DUP_PATCH.START_ROW);
  const endRow = Math.min(range.getRow() + range.getNumRows() - 1, DUP_PATCH.END_ROW);

  if (startRow > endRow) return;

  applyDropdownValueColorCoding_(sheet, startRow, endRow, null);
}


/**
 * Repairs the top prescription energy cells, usually L2:R2.
 *
 * These cells are outside the treatment rows, so they need their own color
 * refresh when a prescription energy dropdown changes.
 */
function applyPrescriptionEnergyColorCoding_(sheet, report) {
  const startCol = DUP_PATCH.REF_FIRST_COL;
  const endCol = DUP_PATCH.REF_LAST_COL;
  const numCols = endCol - startCol + 1;
  const range = sheet.getRange(DUP_PATCH.REF_ENERGY_ROW, startCol, 1, numCols);
  const values = range.getDisplayValues()[0];
  const colorMap = getPrescriptionEnergyColorMap_();
  const backgrounds = [];
  const fontColors = [];
  const fontWeights = [];

  for (let i = 0; i < values.length; i++) {
    const value = String(values[i]).trim();
    const style = colorMap[value] || colorMap[""];

    backgrounds.push(style.background);
    fontColors.push(style.font);
    fontWeights.push(style.bold ? "bold" : "normal");
  }

  range
    .setBackgrounds([backgrounds])
    .setFontColors([fontColors])
    .setFontWeights([fontWeights])
    .setHorizontalAlignment("center")
    .setVerticalAlignment("middle");

  if (report) {
    log_(report, "FIXED", sheet.getName(), "Prescription energy colors repaired in L2:R2.");
  }
}


/**
 * Colors one column according to a value map.
 */
function colorRangeByMap_(sheet, startRow, endRow, col, colorMap) {
  const numRows = endRow - startRow + 1;
  const range = sheet.getRange(startRow, col, numRows, 1);
  const values = range.getDisplayValues();
  const backgrounds = [];
  const fontColors = [];
  const fontWeights = [];

  for (let i = 0; i < values.length; i++) {
    const value = String(values[i][0]).trim();
    const style = colorMap[value] || colorMap[""];

    backgrounds.push([style.background]);
    fontColors.push([style.font]);
    fontWeights.push([style.bold ? "bold" : "normal"]);
  }

  range
    .setBackgrounds(backgrounds)
    .setFontColors(fontColors)
    .setFontWeights(fontWeights)
    .setHorizontalAlignment("center")
    .setVerticalAlignment("middle");
}


/**
 * Phase colors. These mirror the visual pattern in the Dupuytrens log.
 */
function getPhaseColorMap_() {
  return {
    "Phase I":   { background: "#F9CB9C", font: "#783F04", bold: false },
    "Phase II":  { background: "#FFE599", font: "#7F6000", bold: false },
    "Phase III": { background: "#D9EAD3", font: "#008000", bold: false },
    "Phase IV":  { background: "#CFE2F3", font: "#0070C0", bold: false },
    "Phase V":   { background: "#D0E0E3", font: "#134F5C", bold: false },
    "Phase VI":  { background: "#D9D2E9", font: "#351C75", bold: false },
    "":          { background: "#FFFFFF", font: "#000000", bold: false }
  };
}


/**
 * Energy colors. Clinical mismatch conditional formatting can still override
 * these visually with red when the selected energy does not match the phase.
 */
function getEnergyColorMap_() {
  return {
    "50 kV":  { background: "#F4CCCC", font: "#990000", bold: true },
    "70 kV":  { background: "#FCE5CD", font: "#990000", bold: true },
    "100 kV": { background: "#CFE2F3", font: "#0B5394", bold: true },
    "":       { background: "#FFFFFF", font: "#000000", bold: false }
  };
}


/**
 * Prescription table energy colors.
 *
 * Kept separate from treatment-row colors so the top prescription table
 * remains closer to the original blue-header design.
 */
function getPrescriptionEnergyColorMap_() {
  return {
