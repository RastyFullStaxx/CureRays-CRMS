/* ============================================================
 * SAFE FORMATTING
 * ============================================================
 */

/**
 * Wraps only plain-text output columns.
 *
 * This avoids touching dropdown-chip columns:
 * - D Phase
 * - E Energy
 * - M MD Approval
 * - O DOT Approval
 */
function applySafeWrapToEditedRows_(sheet, range) {
  const startRow = Math.max(range.getRow(), DUP_PATCH.START_ROW);
  const endRow = Math.min(range.getRow() + range.getNumRows() - 1, DUP_PATCH.END_ROW);

  if (startRow > endRow) return;

  const numRows = endRow - startRow + 1;
  const safeTextColumns = [
    DUP_PATCH.COL_MD_INITIALS,
    DUP_PATCH.COL_COMMENTS
  ];

  safeTextColumns.forEach(col => {
    sheet.getRange(startRow, col, numRows, 1)
      .setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
  });

  sheet.autoResizeRows(startRow, numRows);
}


/* ============================================================
 * PROTECTION CLEANUP AND WARNING-ONLY PROTECTIONS
 * ============================================================
 */

/**
 * Removes old hard protections from formula areas.
 */
function clearOldFormulaProtections_(sheet, report) {
  const targetRanges = [
    "I11:I80",
    "K11:K80",
    "R11:U80"
  ].map(a1 => sheet.getRange(a1));

  sheet.getProtections(SpreadsheetApp.ProtectionType.RANGE).forEach(protection => {
    const protectedRange = protection.getRange();
    const overlapsFormulaArea = targetRanges.some(targetRange => rangesIntersect_(protectedRange, targetRange));

    if (!overlapsFormulaArea) return;

    try {
      const a1 = protectedRange.getA1Notation();
      protection.remove();
      log_(report, "FIXED", sheet.getName(), "Removed old hard protection from " + a1 + ".");
    } catch (err) {
      log_(report, "WARN", sheet.getName(), "Could not remove old protection: " + err.message);
    }
  });
}


/**
 * Adds warning-only protections to formula cells.
 *
 * Warning-only protections warn staff before editing formulas,
 * but they do not block other users from using the sheet.
 */
function addFormulaWarningProtections_(sheet, report) {
  clearOldFormulaProtections_(sheet, report);

  ["I11:I80", "K11:K80", "R11:U80"].forEach(a1 => {
    try {
      const protection = sheet.getRange(a1).protect();
      protection.setDescription("Warning: " + a1 + " contains formula-driven Dupuytrens calculations.");
      protection.setWarningOnly(true);
      log_(report, "FIXED", sheet.getName(), "Added warning-only protection to " + a1 + ".");
    } catch (err) {
      log_(report, "WARN", sheet.getName(), "Could not add warning-only protection to " + a1 + ": " + err.message);
    }
  });
}


