/* ============================================================
 * HELPER FUNCTIONS
 * ============================================================
 */

function rangeTouchesRows_(range, firstRow, lastRow) {
  const startRow = range.getRow();
  const endRow = startRow + range.getNumRows() - 1;

  return endRow >= firstRow && startRow <= lastRow;
}


function rangeTouchesColumn_(range, targetCol) {
  const startCol = range.getColumn();
  const endCol = startCol + range.getNumColumns() - 1;

  return targetCol >= startCol && targetCol <= endCol;
}


function rangeTouchesAnyColumn_(range, targetCols) {
  return targetCols.some(col => rangeTouchesColumn_(range, col));
}


function rangeTouchesPrescriptionEnergyRow_(range) {
  const startRow = range.getRow();
  const endRow = startRow + range.getNumRows() - 1;
  const startCol = range.getColumn();
  const endCol = startCol + range.getNumColumns() - 1;

  return startRow <= DUP_PATCH.REF_ENERGY_ROW &&
    endRow >= DUP_PATCH.REF_ENERGY_ROW &&
    startCol <= DUP_PATCH.REF_LAST_COL &&
    endCol >= DUP_PATCH.REF_FIRST_COL;
}


function rangesIntersect_(a, b) {
  const aRow1 = a.getRow();
  const aRow2 = a.getRow() + a.getNumRows() - 1;
  const aCol1 = a.getColumn();
  const aCol2 = a.getColumn() + a.getNumColumns() - 1;

  const bRow1 = b.getRow();
  const bRow2 = b.getRow() + b.getNumRows() - 1;
  const bCol1 = b.getColumn();
  const bCol2 = b.getColumn() + b.getNumColumns() - 1;

  return aRow1 <= bRow2 && aRow2 >= bRow1 && aCol1 <= bCol2 && aCol2 >= bCol1;
}


function log_(report, level, area, message) {
  report.push([new Date(), level, area, message]);
}


/**
 * Writes the repair report.
 */
function writeReport_(ss, report) {
  let sheet = ss.getSheetByName(DUP_PATCH.REPORT_SHEET);

  if (!sheet) {
    sheet = ss.insertSheet(DUP_PATCH.REPORT_SHEET);
  }

  sheet.clear();

  const rows = [
    ["Timestamp", "Level", "Area", "Message"]
  ].concat(report);

  sheet.getRange(1, 1, rows.length, 4).setValues(rows);

  sheet.getRange("A1:D1")
    .setFontWeight("bold")
    .setBackground("#d9ead3");

  sheet.getRange(1, 1, rows.length, 4)
    .setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP)
    .setFontFamily("Roboto")
    .setFontSize(10)
    .setVerticalAlignment("top");

  sheet.autoResizeColumns(1, 4);
  sheet.autoResizeRows(1, rows.length);
  sheet.setFrozenRows(1);
}
