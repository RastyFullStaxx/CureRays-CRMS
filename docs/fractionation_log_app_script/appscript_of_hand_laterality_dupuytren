/**
 * DUPUYTRENS FRACTIONATION LOG REPAIR
 * Version: Dupuytrens Log Repair - Formula + Approval Colors - 2026-06-25
 *
 * HOW TO USE
 * 1. Open the Dupuytrens Google Sheet.
 * 2. Go to Extensions > Apps Script.
 * 3. Replace the old script with this full script.
 * 4. Save.
 * 5. Run INSTALL_DUPUYTRENS_LOG_REPAIR() once.
 * 6. Authorize when Google asks.
 *
 * IMPORTANT DESIGN CHOICE
 * This script does NOT recreate dropdown validations.
 * Recreating dropdowns with Apps Script can remove Google Sheets color chips.
 * Existing dropdown validations are preserved.
 * Phase, Energy, MD Approval, and DOT Approval cell colors are repaired by value.
 */

const DUP_PATCH = {
  VERSION: "Dupuytrens Log Repair - Formula + Approval Colors - 2026-06-25",

  SHEET_NAMES: ["Dupuytrens", "Dupuytren's"],
  REPORT_SHEET: "DUPUYTRENS_REPAIR_REPORT",
  NOTE_SHEET: "DUPUYTRENS_SCRIPT_NOTES",
  TIMEZONE: "America/Los_Angeles",

  START_ROW: 11,
  END_ROW: 80,

  LOOKUP_SHEETS: ["50 kV", "70 kV", "100 kV"],

  // Main treatment-log columns.
  COL_FX: 1,                 // A
  COL_PHASE: 4,              // D
  COL_ENERGY: 5,             // E
  COL_SSD: 6,                // F
  COL_TIME: 7,               // G
  COL_DOSE_PER_FX: 8,        // H
  COL_CUM_DOSE: 9,           // I formula
  COL_SKIN_DOSE: 10,         // J
  COL_CUM_SKIN_DOSE: 11,     // K formula
  COL_TECH_INITIALS: 12,     // L
  COL_MD_APPROVAL: 13,       // M dropdown
  COL_MD_INITIALS: 14,       // N approval stamp
  COL_DOT_APPROVAL: 15,      // O dropdown
  COL_COMMENTS: 16,          // P
  COL_DEPTH: 17,             // Q input
  COL_ISODOSE: 18,           // R formula
  COL_DOSE_TO_DOT: 19,       // S formula
  COL_CUM_DOT: 20,           // T formula
  COL_ROUNDED_DEPTH: 21,     // U helper formula

  // Prescription/reference table.
  REF_FIRST_COL: 12,         // L
  REF_LAST_COL: 18,          // R
  REF_PHASE_ROW: 1,
  REF_ENERGY_ROW: 2,
  REF_SSD_ROW: 3,
  REF_TIME_ROW: 4,
  REF_DOSE_ROW: 5,
  REF_SKIN_DOSE_ROW: 6,
  REF_FRACTION_ROW: 7,
  REF_FIELD_SIZE_ROW: 8
};


/* ============================================================
 * MAIN INSTALLER
 * ============================================================
 */

/**
 * Run this once after replacing the old script.
 */
function INSTALL_DUPUYTRENS_LOG_REPAIR() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const report = [];

  log_(report, "INFO", "Start", "Running " + DUP_PATCH.VERSION);

  const sheets = getDupuytrensSheets_(ss);

  if (sheets.length === 0) {
    log_(
      report,
      "ERROR",
      "Sheet detection",
      "No Dupuytrens treatment sheet was found. No clinical sheets were changed."
    );
    writeReport_(ss, report);
    return;
  }

  log_(
    report,
    "INFO",
    "Sheet detection",
    "Detected sheet(s): " + sheets.map(sheet => sheet.getName()).join(", ")
  );

  repairKnownPrescriptionTotals_(sheets, report);
  repairKnownLookupIssues_(ss, report);

  sheets.forEach(sheet => {
    restoreAllDupuytrensFormulas_(sheet, report);
    applyDropdownValueColorCoding_(sheet, DUP_PATCH.START_ROW, DUP_PATCH.END_ROW, report);
    applyPrescriptionEnergyColorCoding_(sheet, report);
    applyClinicalMismatchConditionalFormatting_(sheet, report);
    addFormulaWarningProtections_(sheet, report);
  });

  installDupuytrensApprovalTrigger_(ss, report);
  writeScriptNotes_(ss, report);
  writeReport_(ss, report);

  try {
    ss.toast("Dupuytrens repair complete. See " + DUP_PATCH.REPORT_SHEET + ".", "Dupuytrens Repair", 8);
  } catch (err) {
    Logger.log("Dupuytrens repair complete.");
  }
}


