OPS_DATABASE_URL="postgresql://ops_user:change-me@localhost:5432/curerays_ops"
PHI_DATABASE_URL="postgresql://phi_user:change-me@localhost:5432/curerays_phi"

# Persistence mode for the pilot. The in-memory clinical store is always the
# domain engine; this flag only controls durability.
#   memory  (default) — no Postgres reads or writes; seeded mock data only.
#   prisma            — hydrate the store from Postgres on boot and write every
#                       successful mutation through to Postgres (write-through).
# A failed write-through re-hydrates the store from the database and surfaces as
# a failed save. Requires OPS_DATABASE_URL and PHI_DATABASE_URL above.
CURERAYS_PERSISTENCE_MODE="memory"

# Named local pilot accounts. Store only scrypt hashes generated with
# `PILOT_PASSWORD="..." npm run pilot:password-hash`; never commit passwords.
PILOT_ACCOUNTS_JSON='[{"id":"rad-onc-1","displayName":"Pilot Radiation Oncologist","role":"RAD_ONC","passwordHash":"scrypt$<salt-base64url>$<hash-base64url>"}]'

# Deployment secret used only to sign the eight-hour HttpOnly pilot session.
# Set this to at least 32 random characters; never commit the real value.
PILOT_SESSION_SECRET="<at-least-32-random-characters>"
